{
  "include": ["backend/src"],
  "exclude": ["**/__pycache__", "**/.venv", "**/venv", "**/tests"],

  "pythonVersion": "3.14",
  "typeCheckingMode": "standard",
  "venvPath": ".",
  "venv": ".venv",
  "useLibraryCodeForTypes": true,

  "extraPaths": ["backend", "backend/src", "."],

  "reportImplicitStringConcatenation": "error",

  "reportUnusedImport": "none",
  "reportUnusedVariable": "none",
  "reportMissingTypeStubs": false,
  "reportIncompatibleVariableOverride": "none",
  "reportIncompatibleMethodOverride": "none",

  "reportCallInDefaultInitializer": "error",

  "executionEnvironments": [
    {
      "root": "backend/src/routers",
      "comment": "fastapi puts Depends()/Header() in arg defaults; views are built by kink injection",
      "reportCallInDefaultInitializer": "none",
      "reportCallIssue": "none"
    },
    {
      "root": "backend/src/views",
      "comment": "fastapi Header() lives in dependency arg defaults",
      "reportCallInDefaultInitializer": "none"
    },
    {
      "root": "backend/src/tasks",
      "comment": "services are built by kink injection inside task bodies",
      "reportCallIssue": "none"
    }
  ]
}