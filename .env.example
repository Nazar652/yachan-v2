# Copy to .env (next to docker-compose.yml) and fill in real values.
# docker compose reads this file automatically for ${VAR} interpolation.
# .env is gitignored — never commit real secrets.

# --- Postgres ---
POSTGRES_USER=yachan
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=yachan

# --- Backend secrets (required, no safe defaults in production) ---
# JWT_SECRET: at least 32 bytes. generate e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-at-least-32-bytes-long-random
# IP_HASH_SALT: random, stable per deployment (changing it re-anonymizes all ip hashes)
IP_HASH_SALT=change-me-random-salt
