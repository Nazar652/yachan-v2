# database (async)
DATABASE_URL=postgresql+asyncpg://yachan:yachan@localhost:5433/yachan

# redis
REDIS_URL=redis://localhost:6379/0

# allowed browser origins, comma-separated
CORS_ORIGINS=http://localhost:5173

# auth, required, no default (use at least 32 bytes, e.g. secrets.token_urlsafe(48))
JWT_SECRET=

# salt for hashing poster ips, required, no default
IP_HASH_SALT=

# error + performance monitoring, optional (empty disables sentry)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
